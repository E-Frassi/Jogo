extends Node2D
## Cena principal. Monta o cenário no TileMapLayer e conecta os sistemas do jogo.

const TAMANHO_TILE := 16
const TILE_CHAO := Vector2i(0, 0)
const TILE_PAREDE := Vector2i(1, 0)
const TILE_CHAO_ALT := Vector2i(2, 0)

const MAPA := [
	"##################################################",
	"#................................................#",
	"#................................................#",
	"#................................................#",
	"#................................................#",
	"#................................................#",
	"#................................................#",
	"#.....###############.........##############.....#",
	"#................................................#",
	"#.....................##...##....................#",
	"#.....................##...##....................#",
	"#................................................#",
	"#.............#....................#.............#",
	"#.............#....................#.............#",
	"#.......##....#....................#......##.....#",
	"#.......##....#.....###########....#......##.....#",
	"#.............#....................#.............#",
	"#.............#....................#.............#",
	"#.............#....................#.............#",
	"#.............#.......##...##......#.............#",
	"#.............#.......##...##......#.............#",
	"#.............#....................#.............#",
	"#.............#....................#.............#",
	"#..##########.#....................#..#########..#",
	"#.............#....................#.............#",
	"#................................................#",
	"#.......................###......................#",
	"#.......................###......................#",
	"#................................................#",
	"##################################################",
]

@onready var cenario: TileMapLayer = $Cenario
@onready var jogador = $Jogador


func _ready() -> void:
	_construir_cenario()
	_configurar_camera()


## Lê o MAPA ('#' = parede, '.' = chão) e pinta o TileMapLayer.
func _construir_cenario() -> void:
	for y in MAPA.size():
		var linha: String = MAPA[y]
		for x in linha.length():
			var celula := Vector2i(x, y)
			if linha[x] == "#":
				cenario.set_cell(celula, 0, TILE_PAREDE)
			else:
				var variante := (x * 7 + y * 13) % 5 == 0
				cenario.set_cell(celula, 0, TILE_CHAO_ALT if variante else TILE_CHAO)


func _configurar_camera() -> void:
	var area := cenario.get_used_rect()
	jogador.definir_limites_camera(Rect2i(area.position * TAMANHO_TILE, area.size * TAMANHO_TILE))
